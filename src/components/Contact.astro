---
import type { Content, Locale } from '../i18n';
import { profile } from '../data/profile';

interface Props {
  content: Content;
  locale: Locale;
}

const { content, locale } = Astro.props;
const { contact } = content;
const cvHref = locale === 'es' ? profile.cv.es : profile.cv.en;
const subject =
  locale === 'es' ? 'Contacto profesional desde el portfolio' : 'Professional contact from portfolio';

const encode = (value: string) => Buffer.from(value).toString('base64');
const mailToken = encode(`mailto:${profile.email}?subject=${encodeURIComponent(subject)}`);
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="contact__texture pattern-grid" aria-hidden="true"></div>

  <div class="shell contact__inner">
    <div class="contact__lead" data-reveal>
      <p class="contact__rule" aria-hidden="true"></p>
      <h2 class="contact__title" id="contact-title">{contact.title}</h2>
      <p class="contact__body prose">{contact.body}</p>

      <div class="contact__ctas">
        <button class="btn" type="button" data-protected={mailToken}>
          {contact.emailLabel}
          <span class="btn__arrow" aria-hidden="true">&rarr;</span>
        </button>
        <a class="btn btn--ghost" href={cvHref} download>
          {contact.resumeLabel}
          <span class="btn__arrow" aria-hidden="true">&darr;</span>
        </a>
      </div>

      <noscript>
        <p class="contact__note label">{contact.noScript}</p>
      </noscript>
    </div>

    <div class="contact__links" data-reveal>
      <p class="label contact__links-title">{contact.linksLabel}</p>
      <ul>
        {
          contact.links.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                <span class="link__label">{link.label}</span>
                <span class="link__value">{link.value}</span>
                <span class="link__arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
  }

  .contact__texture {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .contact__inner {
    position: relative;
    display: grid;
    gap: var(--space-2xl);
  }

  .contact__rule {
    width: 4rem;
    height: var(--border-thick);
    background: var(--color-accent);
  }

  .contact__title {
    margin-top: var(--space-md);
    font-size: var(--text-h2);
    text-transform: uppercase;
  }

  .contact__body {
    margin-top: var(--space-md);
    color: var(--color-muted-ink);
  }

  .contact__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
  }

  .contact__ctas .btn {
    flex: 1 1 15rem;
  }

  .contact__note {
    margin-top: var(--space-md);
    max-width: 48ch;
    font-size: var(--text-micro);
    letter-spacing: 0;
    text-transform: none;
  }

  .contact__links {
    border: var(--border-thin) solid var(--color-border);
    background: var(--color-bg);
    align-self: start;
  }

  .contact__links-title {
    padding: var(--space-sm) var(--space-lg);
    border-bottom: var(--border-thin) solid var(--color-border);
    background: var(--color-surface);
  }

  .contact__links a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-2xs) var(--space-md);
    padding: var(--space-md) var(--space-lg);
    border-bottom: var(--border-hair) solid var(--color-border);
    transition: background-color var(--dur-fast) linear, color var(--dur-fast) linear;
  }

  .contact__links li:last-child a {
    border-bottom: 0;
  }

  .contact__links a:hover,
  .contact__links a:focus-visible {
    background: var(--color-fg);
    color: var(--color-bg);
  }

  .link__label {
    grid-column: 1;
    font-size: var(--text-micro);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-accent-ink);
  }

  .contact__links a:hover .link__label,
  .contact__links a:focus-visible .link__label {
    color: var(--color-accent-on-fg);
  }

  .link__value {
    grid-column: 1;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    word-break: break-word;
  }

  .link__arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    font-size: var(--text-h3);
  }

  @media (min-width: 48rem) {
    .contact__ctas .btn {
      flex: 0 1 auto;
    }
  }

  @media (min-width: 64rem) {
    .contact__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-3xl);
      align-items: start;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-protected]').forEach((button) => {
    button.addEventListener('click', () => {
      const token = button.dataset.protected;
      if (token) window.location.href = atob(token);
    });
  });
</script>
