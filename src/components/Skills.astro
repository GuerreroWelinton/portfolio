---
import SectionHeader from './SectionHeader.astro';
import type { Content } from '../i18n';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { skills } = content;
---

<section class="section skills" id="skills" aria-labelledby="skills-title">
  <div class="shell">
    <SectionHeader title={skills.title} titleId="skills-title" />

    <div class="skills__grid">
      {
        skills.groups.map((group, i) => (
          <article class="panel" style={`--reveal-delay:${i * 70}ms`} data-reveal>
            <h3 class="panel__title label">{group.title}</h3>
            <ul class="skills__items">
              {group.items.map((item) => (
                <li class="skills__tag">{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills__grid {
    display: grid;
    gap: var(--space-lg);
  }

  .skills__items {
    display: grid;
    align-content: start;
    gap: var(--space-sm);
    padding: var(--space-lg);
    list-style: none;
    margin: 0;
  }

  .skills__tag {
    border: 0;
    padding: 0;
    font-size: var(--text-micro);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .skills__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .skills__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-xl);
    }
  }
</style>
